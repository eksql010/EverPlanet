  m_Script: {fileID: 11500000, guid: 4f696ff259a749844844f92927fa81ce, type: 3}
  m_Name: MapTriggerQuest
  m_EditorClassIdentifier: Assembly-CSharp::QuestData
  questId: MapTriggerQuest
  title: "\uC624\uB298\uB3C4 \uD55C \uAC78\uC74C \uC131\uC7A5"
  description: "\uC0AC\uB78C\uC774 \uC131\uC7A5\uD558\uAE30 \uC704\uD574\uC11C\uB294
    \uC0C8\uB85C\uC6B4 \uB3C4\uC804\uACFC \uACBD\uD5D8\uC774 \uD544\uC694\uD55C \uBC95\uC774\uC9C0\uC694.
    \uC774 \uADFC\uCC98 \uC5B4\uB518\uAC00\uC5D0 \uB0AF\uC120 \uAE30\uC6B4\uC774
    \uB290\uAEF4\uC9C0\uB294 \uACF3\uC774 \uC788\uB2F5\uB2C8\uB2E4."
  objectiveText: "\uC5B8\uB355 \uADFC\uCC98\uC5D0\uC11C \uB0AF\uC120 \uAE30\uC6B4\uC774
    \uB290\uAEF4\uC9C0\uB294 \uACF3 \uCC3E\uC544\uAC00\uAE30"
  rewardExp: 100
  rewardMoney: 5000
  startDialogue:
  - "\uC5B4\uC11C \uC624\uC138\uC694, \uB2E8\uBE44\uB2D8. \n\n\uC5EC\uAE30\uAE4C\uC9C0
    \uC624\uB290\uB77C \uACE0\uC0DD \uB9CE\uC73C\uC168\uC8E0?"
  - "\uC0AC\uB78C\uC740 \uB298 \uC0C8\uB85C\uC6B4 \uB3C4\uC804\uC744 \uB9C8\uC8FC\uD558\uBA74\uC11C
    \uC870\uAE08\uC529 \uC131\uC7A5\uD574 \uB098\uAC00\uB294 \uBC95\uC774\uB78D\uB2C8\uB2E4."
  - "\uC774 \uADFC\uCC98 \uC5B4\uB518\uAC00\uC5D0 \uB0AF\uC120 \uAE30\uC6B4\uC774
    \uB290\uAEF4\uC9C0\uB294 \uACF3\uC774 \uC788\uC5B4\uC694. \n\n\uD55C\uBC88 \uCC3E\uC544\uAC00
    \uBCF4\uC2DC\uACA0\uC5B4\uC694?"
  progressDialogue:
  - "\uC544\uC9C1 \uADF8 \uC7A5\uC18C\uB97C \uBABB \uCC3E\uC73C\uC168\uB098\uC694?
    \n\uC5B8\uB355 \uCABD\uC744 \uC798 \uC0B4\uD3B4\uBCF4\uC2DC\uBA74 \uAE08\uBC29
    \uB290\uAEF4\uC9C0\uC2E4 \uAC70\uC608\uC694."
  completeDialogue:
  - "\uC815\uB9D0 \uB300\uB2E8\uD558\uC2DC\uB124\uC694! \uBC8C\uC368 \uADF8 \uAE30\uC6B4\uC744
    \uCC3E\uC544\uB0B4\uC2DC\uB2E4\uB2C8."
  - "\uC774\uB7F0 \uC791\uC740 \uACBD\uD5D8\uB4E4\uC774 \uC313\uC5EC\uC11C \uD070
    \uC131\uC7A5\uC774 \uB418\uB294 \uAC70\uB78D\uB2C8\uB2E4."
