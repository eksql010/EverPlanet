  m_Script: {fileID: 11500000, guid: 4f696ff259a749844844f92927fa81ce, type: 3}
  m_Name: TalkQuest
  m_EditorClassIdentifier: Assembly-CSharp::QuestData
  questId: TalkQuest
  title: "\uB2E4\uB978 NPC\uC640 \uCE5C\uD574\uC9C0\uAE30"
  description: "\uD589\uC131 \uBC18\uB300\uD3B8\uC5D0 \uC788\uB294 NPC\uC640 \uB300\uD654\uB97C
    \uD558\uACE0 \uC624\uC138\uC694. \uC774 \uC791\uC740 \uBCC4\uC5D0\uB294 \uC800
    \uB9D0\uACE0\uB3C4 \uB2E4\uB978 \uC774\uC6C3\uC774 \uC0B4\uACE0 \uC788\uB2F5\uB2C8\uB2E4."
  objectiveText: "\uB2E4\uB978 NPC\uC640 \uB300\uD654\uD558\uAE30"
  rewardExp: 200
  rewardMoney: 6000
  startDialogue:
  - "\uC774 \uC791\uC740 \uD589\uC131\uC5D0 \uC800 \uD63C\uC790 \uC0AC\uB294 \uC904
    \uC544\uC168\uB098\uC694? \n\uC0AC\uC2E4 \uBC18\uB300\uD3B8\uC5D0\uB3C4 \uC774\uC6C3\uC774
    \uC0B4\uACE0 \uC788\uB2F5\uB2C8\uB2E4."
  - "\uC624\uB7AB\uB3D9\uC548 \uC11C\uB85C \uC18C\uC2DD\uC744 \uB098\uB204\uC9C0
    \uBABB\uD588\uC5B4\uC694. \n\uAC00\uC11C \uC548\uBD80 \uC880 \uC804\uD574\uC8FC\uC2DC\uACA0\uC5B4\uC694?"
  - "\uD589\uC131 \uBC18\uB300\uD3B8\uC73C\uB85C \uCB49 \uAC78\uC5B4\uAC00\uC2DC\uBA74
    \uB9CC\uB098\uC2E4 \uC218 \uC788\uC744 \uAC70\uC608\uC694. \n\n\uC798 \uBD80\uD0C1\uB4DC\uB824\uC694!"
  progressDialogue:
  - "\uC624~ \uBC18\uB300\uD3B8\uC5D0\uC11C \uC654\uB2E4\uACE0? \n\uC9C4\uC9DC \uC5EC\uAE30\uAE4C\uC9C0
    \uAC78\uC5B4\uC628 \uAC70\uC57C?"
  completeDialogue:
  - "\uC774\uB807\uAC8C \uC5BC\uAD74 \uBCF4\uACE0 \uC778\uC0AC\uD558\uB2C8\uAE4C
    \uD6E8\uC52C \uB0AB\uB2E4, \uADF8\uCE58?"
  - "\uB2E4\uC74C\uC5D0 \uB610 \uC2EC\uC2EC\uD558\uBA74 \uB180\uB7EC \uC640~"
