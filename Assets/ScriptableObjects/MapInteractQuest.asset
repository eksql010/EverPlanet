  m_Script: {fileID: 11500000, guid: 4f696ff259a749844844f92927fa81ce, type: 3}
  m_Name: MapInteractQuest
  m_EditorClassIdentifier: Assembly-CSharp::QuestData
  questId: MapInteractQuest
  title: "\uAF43 \uCC44\uC9D1\uD558\uAE30"
  description: "\uCC44\uC9D1\uC744 \uD574\uBCF4\uC544\uC694. \uAF43 \uC606\uC5D0\uC11C
    \uC2A4\uD398\uC774\uC2A4\uBC14\uB97C \uB204\uB978 \uCC44 \uAE30\uB2E4\uB9AC\uBA74
    \uC790\uC5F0\uC2A4\uB808 \uAEBE\uC744 \uC218 \uC788\uC744 \uAC70\uC608\uC694."
  objectiveText: "\uC11C\uCABD\uC5D0 \uC788\uB294 \uBD89\uC740 \uAF43 \uCC44\uC9D1\uD558\uAE30"
  rewardExp: 400
  rewardMoney: 10000
  startDialogue:
  - "\uC694\uC998 \uADFC\uCC98\uC5D0 \uC608\uC05C \uBD89\uC740 \uAF43\uC774 \uD53C\uC5C8\uB2E4\uB294
    \uC18C\uBB38\uC744 \uB4E4\uC73C\uC168\uB098\uC694?"
  - "\uB3D9\uCABD\uC5D0 \uAC00\uC2DC\uBA74 \uADF8 \uAF43\uC744 \uBCF4\uC2E4 \uC218
    \uC788\uC744 \uAC70\uC608\uC694. \n\uD5A5\uC774 \uC544\uC8FC \uC88B\uB2E4\uACE0
    \uD558\uB354\uB77C\uACE0\uC694."
  - "\uAF43 \uC606\uC5D0\uC11C \uC7A0\uC2DC \uBA38\uBB3C\uB7EC \uACC4\uC2DC\uBA74
    \uC790\uC5F0\uC2A4\uB7FD\uAC8C \uAEBE\uC744 \uC218 \uC788\uC744 \uAC70\uC608\uC694.
    \n\n\uD55C\uBC88 \uB2E4\uB140\uC640 \uBCF4\uC2DC\uACA0\uC5B4\uC694?"
  progressDialogue:
  - "\uC544\uC9C1 \uAF43\uC744 \uBABB \uAEBE\uC73C\uC168\uB098\uC694? \n\uC11C\uCABD\uC73C\uB85C
    \uAC00\uBA74 \uBCF4\uC77C \uAC70\uC608\uC694.\n\uAF43 \uC606\uC5D0\uC11C \uC2A4\uD398\uC774\uC2A4\uBC14\uB97C
    \uB204\uB978 \uCC44 \uACC4\uC154\uBCF4\uC138\uC694."
  completeDialogue:
  - "\uC6B0\uC640, \uD5A5\uC774 \uC815\uB9D0 \uC88B\uB124\uC694! \uC608\uC05C \uAF43\uC744
    \uAEBE\uC5B4\uC624\uC168\uAD70\uC694."
  - "\uC774 \uAF43\uC73C\uB85C \uBB58 \uB9CC\uB4E4\uBA74 \uC88B\uC744\uC9C0 \uAC19\uC774
    \uACE0\uBBFC\uD574\uBD10\uC694."
