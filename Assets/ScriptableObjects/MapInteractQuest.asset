  m_Script: {fileID: 11500000, guid: 4f696ff259a749844844f92927fa81ce, type: 3}
  m_Name: MapInteractQuest
  m_EditorClassIdentifier: Assembly-CSharp::QuestData
  questId: MapInteractQuest
  title: "\uAF43 \uAEBE\uAE30"
  description: "\uCC44\uC9D1\uC744 \uD574\uBCF4\uC544\uC694 \uC2A4\uD398\uC774\uC2A4\uBC14\uB97C
    \uAFB9 \uB204\uB974\uBA74 \uB429\uB2C8\uB2E4"
  objectiveText: "\uB3D9\uCABD\uC5D0 \uC788\uB294 \uBD89\uC740 \uAF43 \uCC44\uC9D1\uD558\uAE30"
  rewardExp: 400
  rewardMoney: 10000
  startDialogue:
  - "\uC548\uB155\uD558\uC138\uC694. \n\nNPC\uC758 \uD018\uC2A4\uD2B8 \uB9C1\uD06C
    \uD074\uB9AD \uC2DC \uB300\uC0AC \uCD9C\uB825 \uD14C\uC2A4\uD2B8\uC785\uB2C8\uB2E4."
  - "\uB450 \uBC88\uC9F8 \uD398\uC774\uC9C0\uC785\uB2C8\uB2E4. \n\n\uBB54\uAC00 \uD018\uC2A4\uD2B8\uB97C
    \uC124\uBA85\uD558\uACE0 \uC788\uC744 \uAC81\uB2C8\uB2E4."
  - "\uB9C8\uC9C0\uB9C9 \uD398\uC774\uC9C0\uC785\uB2C8\uB2E4.\n\n\uD018\uC2A4\uD2B8\uB97C
    \uB2E4 \uC124\uBA85\uD558\uACE0 \uC774\uC81C \uC6B0\uCE21 \uD558\uB2E8\uC5D0
    \uD018\uC2A4\uD2B8 \uC218\uB77D \uB9C1\uD06C \uBC84\uD2BC\uC744 \uCD94\uAC00\uD560
    \uC608\uC815\uC785\uB2C8\uB2E4. \uADF8 \uBC84\uD2BC\uC744 \uB20C\uB7EC\uC57C
    \uD574\uB2F9 \uD018\uC2A4\uD2B8\uAC00 \uC9C4\uD589 \uC911\uC778 \uC0C1\uD0DC\uB85C
    \uBC14\uB01D\uB2C8\uB2E4."
  progressDialogue:
  - "\uCC44\uC9D1\uC774 \uC5B4\uB824\uC6CC? \uC2A4\uD398\uC774\uC2A4\uBC14\uB97C
    \uAFB9 \uB204\uB974\uBA74 \uB3FC"
  completeDialogue:
  - "\uB300\uB2E8\uD574\uC694! \uCE90\uC624\uC168\uAD70\uC694"
  - "\uB2E4\uC74C\uC740 \uBCF4\uC0C1 \uD398\uC774\uC9C0\uAC00 \uB098\uC62C \uAC70\uC608\uC694"
